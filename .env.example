# Local CLI: copy this file to .env and add your real key.
# Vercel: add these under Settings > Environment Variables instead
# (the deployed functions read them from the platform, not from .env).
# Keep .env private and never commit it.

# Required. Google AI Studio key used for the live GEO search query.
GEMINI_API_KEY=your-api-key-here

# Optional. Defaults to gemini-3.8-flash if unset.
GEMINI_MODEL=gemini-3.8-flash
